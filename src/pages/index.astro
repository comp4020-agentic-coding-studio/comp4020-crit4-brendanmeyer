---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="An instrument"
  description="A string harp played by mouse, touch or keyboard — click, drag, or press keys to play."
>
  <header class="sr-only">
    <nav aria-label="Primary">
      <a href="./">Home</a>
    </nav>
  </header>
  <main>
    <h1 class="sr-only">An instrument</h1>
    <div
      id="harp"
      role="application"
      aria-label="A string harp. Click or drag across the screen, or press Q through ] on the keyboard, to play."
    >
      <div class="hint" aria-hidden="true"></div>
    </div>
  </main>
  <script src="../scripts/main.ts"></script>
</Layout>

<style>
  main {
    max-width: none;
    margin: 0;
  }

  #harp {
    position: fixed;
    inset: 0;
    overflow: hidden;
    touch-action: none;
    cursor: crosshair;
  }

  :global(.string) {
    position: absolute;
    top: 8%;
    bottom: 8%;
    width: 2px;
    background: #e8e6ff;
    opacity: 0;
    transform: translateX(-50%) scaleY(0.85);
    transition:
      opacity 900ms ease,
      transform 900ms ease;
    pointer-events: none;
  }

  :global(.string.played) {
    opacity: 0.28;
    transform: translateX(-50%) scaleY(1);
  }

  :global(.string.flash) {
    opacity: 0.95;
    transition:
      opacity 120ms ease-out,
      transform 900ms ease;
  }

  .hint {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 14vmin;
    height: 14vmin;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(232 230 255 / 55%) 0%, rgb(232 230 255 / 0%) 70%);
    transform: translate(-50%, -50%);
    pointer-events: none;
    animation: hint-pulse 2.2s ease-in-out infinite;
    transition: opacity 500ms ease;
  }

  .hint.gone {
    opacity: 0;
  }

  @keyframes hint-pulse {
    0%,
    100% {
      opacity: 0.35;
      transform: translate(-50%, -50%) scale(0.85);
    }
    50% {
      opacity: 0.9;
      transform: translate(-50%, -50%) scale(1.15);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hint {
      animation: none;
      opacity: 0.5;
    }
  }
</style>
